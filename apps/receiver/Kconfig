mainmenu "Gate Link receiver"

menu "Gate Link receiver"

module = GATE_RX
module-str = gate_rx
source "subsys/logging/Kconfig.template.log_config"

config GATE_RX_ACCEPTED_DEVICE_ID
	int "Accepted transmitter device id"
	default 1
	range 1 2147483647
	help
	  Device id of the transmitter this receiver answers. Commands carrying
	  any other device id are ignored without an ACK. Duplicate detection
	  tracks the last accepted sequence for this identity.

	  This is addressing, not authentication: a device id is trivial to
	  spoof and only phase 8 makes a command unforgeable.

config GATE_RX_RECEIVE_TIMEOUT_MS
	int "Bench receive timeout in milliseconds"
	default 10000
	range 1000 60000
	help
	  Timeout used while waiting for bench LoRa packets.

config GATE_RX_ACTUATOR_PULSE_MS
	int "Actuator output pulse in milliseconds"
	default 300
	range 1 10000
	help
	  Time the actuator output stays active for one accepted trigger command.

endmenu

rsource "../../common/Kconfig"

source "Kconfig.zephyr"
