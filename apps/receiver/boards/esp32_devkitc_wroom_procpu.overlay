 *
 * SPDX-License-Identifier: MIT OR Apache-2.0
 *
 * Receiver wiring for ESP32 DevKitC V4 (WROOM-32D) with a HopeRF RFM95W.
 *
 *   RFM95W          ESP32      note
 *   ------          -----      ----
 *   SCK             GPIO18     spi3 / VSPI, board default pinctrl
 *   MISO            GPIO19     spi3 / VSPI, board default pinctrl
 *   MOSI            GPIO23     spi3 / VSPI, board default pinctrl
 *   NSS  (CS)       GPIO5      spi3 hardware chip select, board default pinctrl
 *   RESET           GPIO17     active low on SX1276
 *   DIO0            GPIO16     TxDone / RxDone interrupt
 *   3V3, GND        3V3, GND   3.3 V only - 5 V destroys the module
 *
 *   actuator out    GPIO25     LED on the bench, isolated driver once installed
 *   status LED      GPIO33     series resistor to GND
 *
 * GPIO25 is deliberately not a strapping pin: it stays low through reset, so
 * the actuator cannot glitch active at boot once it drives a real contact.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		gate-actuator = &gate_actuator;
		gate-status = &gate_status;
		lora0 = &lora0;
	};

	gate_outputs {
		compatible = "gpio-leds";

		/*
		 * The actuator is an LED on the bench and an isolated contact
		 * driver once installed (D003). Only this node changes.
		 */
		gate_actuator: gate_actuator {
			gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
			label = "Actuator output";
		};

		gate_status: gate_status {
			/* ESP32 GPIO33 is controller gpio1 offset 1. */
			gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
			label = "Receiver status";
		};
	};
};

&spi3 {
	status = "okay";
	/*
	 * No cs-gpios here on purpose. The board's spim3_default pinctrl already
	 * routes the SPI3 hardware chip select to GPIO5 (SPIM3_CSEL_GPIO5), and
	 * spi_esp32_spim.c only keeps NSS asserted across a multi-buffer
	 * transfer when no cs-gpios is declared:
	 *
	 *   hal_trans->cs_keep_active = (!ctx->num_cs_gpios && (...));
	 *
	 * Declaring cs-gpios made that false, so the controller raised NSS after
	 * every single byte. The SX1276 needs NSS low across the whole
	 * address+data pair, so it saw only orphan address bytes and answered
	 * 0x00 to everything, including REG_VERSION.
	 */

	lora0: lora@0 {
		compatible = "semtech,sx1276";
		reg = <0>;
		reset-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
		/*
		 * Only DIO0 is required for TX/RX completion. Wire and list
		 * DIO1/DIO2 here as well if a later phase needs them.
		 */
		dio-gpios = <&gpio0 16 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		/* Conservative for breadboard wiring; raise once validated. */
		spi-max-frequency = <1000000>;
		/* The RFM95W only routes the PA_BOOST output. */
		power-amplifier-output = "pa-boost";
	};
};
